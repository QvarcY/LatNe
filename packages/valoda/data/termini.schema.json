{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "LatNe terminoloģijas reģistrs",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schemaVersion",
                     "project",
                     "inventoryVersion",
                     "status",
                     "scope",
                     "sources",
                     "terms"
                 ],
    "properties":  {
                       "schemaVersion":  {
                                             "type":  "integer",
                                             "minimum":  1
                                         },
                       "project":  {
                                       "const":  "LatNe"
                                   },
                       "inventoryVersion":  {
                                                "type":  "integer",
                                                "minimum":  1
                                            },
                       "status":  {
                                      "type":  "string"
                                  },
                       "updated":  {
                                       "type":  "string"
                                   },
                       "scope":  {
                                     "type":  "string"
                                 },
                       "note":  {
                                    "type":  "string"
                                },
                       "sources":  {
                                       "type":  "array",
                                       "items":  {
                                                     "type":  "object",
                                                     "required":  [
                                                                      "id",
                                                                      "title",
                                                                      "url",
                                                                      "checked"
                                                                  ]
                                                 }
                                   },
                       "terms":  {
                                     "type":  "array",
                                     "items":  {
                                                   "type":  "object",
                                                   "additionalProperties":  false,
                                                   "required":  [
                                                                    "order",
                                                                    "id",
                                                                    "source",
                                                                    "layers",
                                                                    "kind",
                                                                    "category",
                                                                    "status",
                                                                    "latvian",
                                                                    "suggestions",
                                                                    "rejectedVariants",
                                                                    "notes",
                                                                    "sourceRefs"
                                                                ],
                                                   "properties":  {
                                                                      "order":  {
                                                                                    "type":  "integer",
                                                                                    "minimum":  1
                                                                                },
                                                                      "id":  {
                                                                                 "type":  "string",
                                                                                 "minLength":  1
                                                                             },
                                                                      "source":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1
                                                                                 },
                                                                      "layers":  {
                                                                                     "type":  "array",
                                                                                     "minItems":  1,
                                                                                     "uniqueItems":  true,
                                                                                     "items":  {
                                                                                                   "enum":  [
                                                                                                                "javascript",
                                                                                                                "typescript"
                                                                                                            ]
                                                                                               }
                                                                                 },
                                                                      "kind":  {
                                                                                   "enum":  [
                                                                                                "keyword",
                                                                                                "reserved",
                                                                                                "contextual",
                                                                                                "literal",
                                                                                                "type-keyword",
                                                                                                "builtin-value"
                                                                                            ]
                                                                               },
                                                                      "category":  {
                                                                                       "type":  "string",
                                                                                       "minLength":  1
                                                                                   },
                                                                      "status":  {
                                                                                     "enum":  [
                                                                                                  "pending",
                                                                                                  "approved",
                                                                                                  "rejected",
                                                                                                  "reserved"
                                                                                              ]
                                                                                 },
                                                                      "latvian":  {
                                                                                      "type":  [
                                                                                                   "string",
                                                                                                   "null"
                                                                                               ]
                                                                                  },
                                                                      "suggestions":  {
                                                                                          "type":  "array",
                                                                                          "items":  {
                                                                                                        "type":  "string"
                                                                                                    }
                                                                                      },
                                                                      "rejectedVariants":  {
                                                                                               "type":  "array",
                                                                                               "items":  {
                                                                                                             "type":  "object"
                                                                                                         }
                                                                                           },
                                                                      "notes":  {
                                                                                    "type":  "string"
                                                                                },
                                                                      "sourceRefs":  {
                                                                                         "type":  "array",
                                                                                         "minItems":  1,
                                                                                         "uniqueItems":  true,
                                                                                         "items":  {
                                                                                                       "type":  "string"
                                                                                                   }
                                                                                     }
                                                                  }
                                               }
                                 }
                   }
}
